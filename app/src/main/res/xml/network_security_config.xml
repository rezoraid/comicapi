<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow image hosts used by the API -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">lms.imgsvr.my.id</domain>
        <domain includeSubdomains="true">static.mantacdn.net</domain>
        <domain includeSubdomains="true">web-production-b2a1d.up.railway.app</domain>
    </domain-config>
</network-security-config>
