# Port (Railway/Heroku mengisi otomatis)
PORT=3000

# Wajib diisi di production. Klien kirim header: x-api-key: <nilai ini>
API_KEY=

# '*' atau daftar origin dipisah koma (hanya perlu kalau diakses dari browser)
CORS_ORIGIN=*

# Rate limit per IP per menit (gambar punya batas sendiri karena 1 chapter = puluhan gambar)
RATE_LIMIT_MAX=120
IMAGE_RATE_LIMIT_MAX=1500

# Jumlah maksimal entri cache di memori
CACHE_MAX=1000

# Timeout total per request ke sumber (ms)
REQUEST_TIMEOUT_MS=25000

# false kalau server langsung terbuka ke internet tanpa proxy
TRUST_PROXY=true
LOG_REQUESTS=true

# false = matikan halaman /playground
PLAYGROUND=true

# Kalau sumber memblokir IP server (HTTP 403), request otomatis diulang lewat relay.
# Isi dengan URL Worker milikmu ({url} = URL tujuan), pisahkan beberapa relay dengan tanda |
# Contoh: https://relay-kamu.workers.dev/?key=RAHASIA&url={url}
# Kosong = pakai relay publik bawaan (kurang stabil). Per sumber: KOMIKU_RELAY, LUMOS_RELAY
RELAY_URL=
# false = matikan relay publik bawaan
RELAY_PUBLIC=true
